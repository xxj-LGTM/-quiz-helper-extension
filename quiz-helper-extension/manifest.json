{
  "manifest_version": 3,
  "name": "题目助手 · 网页识题解题",
  "version": "1.0.0",
  "description": "识别网页上的题目或截图中的题目，调用免费大模型 API 给出答案与解析。",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "题目助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "solve-selection": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "解答选中的题目"
    }
  }
}
